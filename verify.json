{
  "round_trip": [
    {
      "do": "GET /api/status",
      "name": "status signed out",
      "expect": {
        "signed_in": false,
        "can_send": false,
        "anonymous": false
      }
    },
    {
      "do": "GET /api/feedback",
      "name": "list signed out",
      "expect": {
        "source": "local",
        "items": []
      }
    },
    {
      "do": "POST /api/feedback",
      "name": "send signed out is refused",
      "body": {
        "kind": "bug",
        "text": "Verify {{run}} should not send"
      },
      "status": 403
    },
    {
      "do": "POST /api/draft",
      "name": "save draft",
      "body": {
        "kind": "feature",
        "text": "Verify {{run}} draft"
      }
    },
    {
      "do": "POST /api/status-check",
      "name": "status mapping",
      "body": {
        "cases": [
          {
            "state": "open",
            "labels": [
              "triage",
              "bug"
            ]
          },
          {
            "state": "open",
            "labels": [
              "building"
            ]
          },
          {
            "state": "closed",
            "state_reason": "completed",
            "closed_at": "2026-11-10T08:00:00Z"
          },
          {
            "state": "closed",
            "state_reason": "not_planned",
            "closed_at": "2026-11-11T02:52:00Z"
          },
          {
            "state": "closed",
            "state_reason": "completed",
            "labels": [
              "rejected"
            ]
          }
        ]
      },
      "expect": {
        "results.0.key": "received",
        "results.0.line": "Got it — the team is sorting it",
        "results.1.line": "Being built now",
        "results.2.key": "done",
        "results.2.base": "Done ✓",
        "results.2.show": "date",
        "results.3.key": "not_planned",
        "results.3.base": "Declined by the team",
        "results.3.show": "datetime",
        "results.3.step": -1,
        "results.4.key": "not_planned"
      }
    },
    {
      "restart": true
    },
    {
      "do": "GET /api/draft",
      "name": "draft read back after restart",
      "expect": {
        "kind": "feature",
        "text": "Verify {{run}} draft"
      }
    },
    {
      "do": "GET /api/switches",
      "name": "switch off by default",
      "expect": {
        "switches.0.id": "anonymous",
        "switches.0.on": false
      }
    }
  ]
}
